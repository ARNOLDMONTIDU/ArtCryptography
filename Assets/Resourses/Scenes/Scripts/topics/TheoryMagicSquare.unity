  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\t\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u0430\u043C\u0438
    \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0435
    \u0442\u0430\u0431\u043B\u0438\u0446\u044B \u0441 \u0432\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u043C\u0438
    \u0432 \u0438\u0445 \u043A\u043B\u0435\u0442\u043A\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
    \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u0447\u0438\u0441\u043B\u0430\u043C\u0438,
    \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u043E\u0442 1 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0434\u0430\u044E\u0442 \u0432 \u0441\u0443\u043C\u043C\u0435 \u043F\u043E \u043A\u0430\u0436\u0434\u043E\u043C\u0443
    \u0441\u0442\u043E\u043B\u0431\u0446\u0443, \u043A\u0430\u0436\u0434\u043E\u0439
    \u0441\u0442\u0440\u043E\u043A\u0435 \u0438 \u043A\u0430\u0436\u0434\u043E\u0439
    \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u0438 \u043E\u0434\u043D\u043E
    \u0438 \u0442\u043E \u0436\u0435 \u0447\u0438\u0441\u043B\u043E. \n\t\u0428\u0438\u0444\u0440\u0443\u0435\u043C\u044B\u0439
    \u0442\u0435\u043A\u0441\u0442 \u0432\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u044B
    \u0432 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438
    \u0441 \u043D\u0443\u043C\u0435\u0440\u0430\u0446\u0438\u0435\u0439 \u0438\u0445
    \u043A\u043B\u0435\u0442\u043E\u043A. \u0414\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
    \u0448\u0438\u0444\u0440\u043E\u0442\u0435\u043A\u0441\u0442\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
    \u043F\u043E\u043B\u0443\u0447\u0438\u0432\u0448\u0435\u0439\u0441\u044F \u0442\u0430\u0431\u043B\u0438\u0446\u044B
    \u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0447\u043D\u043E.
    \u041F\u0440\u0438\u043C\u0435\u0440 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u0430 \u0438 \u0435\u0433\u043E \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435\u043C \xAB\u041F\u0420\u0418\u041B\u0415\u0422\u0410\u042E
    \u0412\u041E\u0421\u042C\u041C\u041E\u0413\u041E\xBB.\\n\t\u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
    \u0448\u0438\u0444\u0440\u043E\u0442\u0435\u043A\u0441\u0442: \xAB\u041E\u0418\u0420\u041C\u0415\u041E\u0421\u042E\u0412\u0422\u0410\u042C\u041B\u0413\u041E\u041F\xBB."
