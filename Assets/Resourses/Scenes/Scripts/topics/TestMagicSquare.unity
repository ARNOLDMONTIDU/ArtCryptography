--- !u!114 &859526694
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 859526687}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2051d29c7eb19a04eaed5b114ee527da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questions:
  - question: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u0432\u0430\u0434\u0440\u0430\u0442?"
    answers:
    - "\u041A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u0430\u044F \u0442\u0430\u0431\u043B\u0438\u0446\u0430,
      \u0433\u0434\u0435 \u0441\u0443\u043C\u043C\u044B \u0447\u0438\u0441\u0435\u043B
      \u0432 \u0441\u0442\u0440\u043E\u043A\u0430\u0445, \u0441\u0442\u043E\u043B\u0431\u0446\u0430\u0445
      \u0438 \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u044F\u0445 \u0440\u0430\u0432\u043D\u044B"
    - "\u0422\u0430\u0431\u043B\u0438\u0446\u0430, \u0433\u0434\u0435 \u0432\u0441\u0435
      \u0447\u0438\u0441\u043B\u0430 \u0440\u0430\u0437\u043D\u044B\u0435 \u0438
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435"
    - "\u0422\u0430\u0431\u043B\u0438\u0446\u0430, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u0430\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0440\u0430\u0441\u0447\u0435\u0442\u043E\u0432"
  - question: "\u041A\u0430\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u0443\u043C\u043C\u0430 \u0447\u0438\u0441\u0435\u043B \u0432 \u0441\u0442\u0440\u043E\u043A\u0435
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u0430?"
    answers:
    - "\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0430"
    - "\u0413\u043B\u0430\u0432\u043D\u0430\u044F \u0441\u0443\u043C\u043C\u0430"
    - "\u041A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u044B\u0439 \u043A\u043E\u0440\u0435\u043D\u044C"
  - question: "\u041A\u0430\u043A\u043E\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A
      \u0438\u043C\u0435\u0435\u0442 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u0432\u0430\u0434\u0440\u0430\u0442, \u0435\u0441\u043B\u0438 \u0432
      \u043D\u0435\u043C 9 \u043A\u043B\u0435\u0442\u043E\u043A?"
    answers:
    - "3\xD73"
    - "2\xD72"
    - "4\xD74"
  - question: "\u041A\u0430\u043A\u043E\u0435 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u043E
      \u0434\u043E\u043B\u0436\u043D\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C\u0441\u044F
      \u0434\u043B\u044F \u0432\u0441\u0435\u0445 \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u0435\u0439
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u0430?"
    answers:
    - "\u0418\u043C\u0435\u0442\u044C \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u0443\u044E
      \u0441\u0443\u043C\u043C\u0443 \u0447\u0438\u0441\u0435\u043B"
    - "\u0421\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0435\u0442\u043D\u044B\u0435 \u0447\u0438\u0441\u043B\u0430"
    - "\u0411\u044B\u0442\u044C \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u043C\u0438
      \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
