  m_text: "\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F \xAB\u0420\u0410\u0417\u0423\u041C\u0410
    \u041B\u0418\u0428\u0410\u0415\u0422 \u041D\u0415 \u0421\u041E\u041C\u041D\u0415\u041D\u0418\u0415,
    \u0410 \u0423\u0412\u0415\u0420\u0415\u041D\u041D\u041E\u0421\u0422\u042C\xBB,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0443
    \u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u0426\u0435\u0437\u0430\u0440\u044F
    \u0441 \u043A\u043B\u044E\u0447\u043E\u043C k = 5. \u041E\u0442\u0432\u0435\u0442
    \u0432\u0432\u043E\u0434\u0438\u0442\u044C \u0431\u0435\u0437 \u043E\u0442\u0441\u0442\u0443\u043F\u043E\u0432
    \u0438 \u0437\u043D\u0430\u043A\u043E\u0432 \u043F\u0440\u0435\u043F\u0438\u043D\u0430\u043D\u0438\u044F."
